//! member: false
//! ww43 probe: one call of fs_set_owner, for the tab and for lupin at a terminal (chapter 34's builtins).
//! -1 -1 leaves both ids alone: a call that changes nothing.
fn row() -> str {
    fs_set_owner(".", -1, -1, true) else |e| {
        return match e {
            not_found => "not_found",
            denied => "denied",
            invalid => "invalid",
            unsupported => "unsupported",
            io => "io",
        }
    }
    "ok"
}

fn main() -> !int {
    print("set_owner: {row()}")
    0
}
