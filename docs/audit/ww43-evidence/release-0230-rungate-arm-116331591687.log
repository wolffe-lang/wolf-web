2026-10-15T08:46:33.5902641Z   || { echo "::error::checked tier: $rec"; exit 1; }
2026-10-15T08:46:33.5903184Z echo "checked tier: $(echo "$rec" | jq -r .verdict), $(echo "$rec" | jq -r .stdout_inline | head -1)"
