2026-10-15T08:46:33.5879510Z wolf="$dir/wolf"
2026-10-15T08:46:33.5879925Z test -x "$wolf" && test -f "$dir/libwolf_rt.a" && test -x "$dir/wolf-cimport-worker"
2026-10-15T08:46:33.5880496Z # The floor, measured on the shipped binary rather than assumed
2026-10-15T08:46:33.5881003Z # from the runner: the highest GLIBC symbol version it imports.
2026-10-15T08:46:33.5881612Z need=$(objdump -T "$wolf" | grep -o 'GLIBC_[0-9.]*' | sort -uV | tail -1)
2026-10-15T08:46:33.5882165Z echo "highest GLIBC symbol version needed: ${need:-none}"
2026-10-15T08:46:33.5882612Z minor=${need#GLIBC_2.}; minor=${minor%%.*}
2026-10-15T08:46:33.5883012Z if [ -n "$need" ] && [ "$minor" -gt 35 ]; then
2026-10-15T08:46:33.5883527Z   echo "::error::${need} is above the 2.35 floor (#447) — this archive will not start on Ubuntu 22.04"
2026-10-15T08:46:33.5884077Z   exit 1
2026-10-15T08:46:33.5884300Z fi
2026-10-15T08:46:33.5884684Z # The D57 stamp: bare at a release tag; an rc rehearses on a +dev build.
2026-10-15T08:46:33.5885112Z v=$("$wolf" --version | head -1)
2026-10-15T08:46:33.5885394Z echo "$v"
2026-10-15T08:46:33.5885711Z if [ "$PRERELEASE" = "false" ]; then
2026-10-15T08:46:33.5886213Z   case "$v" in *+dev*) echo "::error::the release build carries the dev suffix: $v"; exit 1 ;; esac
2026-10-15T08:46:33.5886742Z fi
2026-10-15T08:46:33.5887403Z printf 'fn main() -> !int {\n    print("hello, wolf")\n    0\n}\n' > hello.lu
2026-10-15T08:46:33.5887901Z if [ "$(uname -m)" = "aarch64" ]; then
2026-10-15T08:46:33.5888303Z   # linux aarch64 is served by NEITHER compiled tier yet (D35's
2026-10-15T08:46:33.5888768Z   # matrix: native is s28/s59/s60a, release is s41/s127, the rest
2026-10-15T08:46:33.5889485Z   # is c13). What the archive owes this host is a refusal BY NAME
2026-10-15T08:46:33.5889992Z   # with exit 2 — exit 2 with nothing said is #447's second
2026-10-15T08:46:33.5890468Z   # defect exactly — and a checked tier that still runs the
2026-10-15T08:46:33.5890928Z   # program. rc.1 (run 35716056293) asked this host for a native
2026-10-15T08:46:33.5891412Z   # run and went red on the refusal; the gate was wrong, not the
2026-10-15T08:46:33.5891962Z   # archive.
2026-10-15T08:46:33.5892360Z   set +e; out=$("$wolf" run hello.lu 2>&1); rc=$?; set -e
2026-10-15T08:46:33.5892916Z   grep -q "this host cannot run the native tier" <<< "$out" && [ "$rc" -eq 2 ] \
2026-10-15T08:46:33.5893460Z     || { echo "::error::native tier on aarch64 linux: exit $rc: $out"; exit 1; }
2026-10-15T08:46:33.5893924Z   echo "native tier: refuses by name, exit $rc"
2026-10-15T08:46:33.5894474Z   set +e; out=$(WOLF_CLANG=clang-15 "$wolf" run --release hello.lu 2>&1); rc=$?; set -e
2026-10-15T08:46:33.5895058Z   grep -q "this host cannot run the release tier" <<< "$out" && [ "$rc" -ne 0 ] \
2026-10-15T08:46:33.5895635Z     || { echo "::error::release tier on aarch64 linux: exit $rc: $out"; exit 1; }
2026-10-15T08:46:33.5896114Z   echo "release tier: refuses by name, exit $rc"
2026-10-15T08:46:33.5896482Z else
2026-10-15T08:46:33.5896758Z   # native tier (the default, `wolf run`)
2026-10-15T08:46:33.5897342Z   out=$("$wolf" run hello.lu)
2026-10-15T08:46:33.5897923Z   test "$out" = "hello, wolf" || { echo "::error::native tier: $out"; exit 1; }
2026-10-15T08:46:33.5898341Z   echo "native tier: $out"
2026-10-15T08:46:33.5898709Z   # release tier (LLVM, through clang-15)
2026-10-15T08:46:33.5899460Z   out=$(WOLF_CLANG=clang-15 "$wolf" run --release hello.lu)
2026-10-15T08:46:33.5899954Z   test "$out" = "hello, wolf" || { echo "::error::release tier: $out"; exit 1; }
2026-10-15T08:46:33.5900442Z   echo "release tier: $out"
2026-10-15T08:46:33.5900718Z fi
2026-10-15T08:46:33.5901109Z # checked tier — it answers only through conform-run --checked
2026-10-15T08:46:33.5901565Z rec=$("$wolf" conform-run hello.lu --checked --json)
