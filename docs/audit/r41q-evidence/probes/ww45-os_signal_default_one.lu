//! member: false
//! ww45 probe: one call of os_signal_default_one, for the tab and for lupin at a terminal (0.2.33's builtins, book §34.6).
//! 0 is no meaning: `invalid` by its shape, before any host is asked, so nothing changes.
fn row() -> str {
    os_signal_default_one(0) else |e| {
        return match e {
            invalid => "invalid",
            io => "io",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn main() -> !int {
    print("default_one: {row()}")
    0
}
