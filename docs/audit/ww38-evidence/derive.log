## corpus/memory/raw_repr_packed_layout.lu
//! check: run(exit=0, stdout="1 2 0 0 0 3 4 5 0 0 0 6\n17 3735928559 34\n255 0 0 16 0 0 0 0 0 0\n255 1048576\n")
//! phase: run
//! conforms: abi.layout.packed, abi.layout.c, mem.unsafe.raw.1
//!
//! kw08 (K4, STATUS #31): `#[repr(c, packed)]` is alignment 1 and no
//! padding through a raw pointer. `{u8, u32, u8}` is offsets 0 1 5,
//! size 6, so `p[1]` starts at byte 6 (C3 under plain `#[repr(c)]` is
//! 0 4 8, size 12); a GDTR-shaped `{u16, u64}` is offsets 0 2, size 10.
